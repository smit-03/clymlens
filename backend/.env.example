# Copy to .env for local development. .env is git-ignored.

ENV=local

# --- AWS / storage ---
AWS_REGION=ap-south-1
S3_BUCKET=clymlens-dev
S3_PREFIX=weather-data/
# Local development against a fake S3 (moto server): set the endpoint below and the
# bucket is auto-created on startup. Leave empty to use real AWS S3.
S3_ENDPOINT_URL=http://localhost:5000
# Real AWS credentials come from the standard chain (aws configure / SSO / env).
# With S3_ENDPOINT_URL set, any dummy values work:
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- Open-Meteo ---
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
HTTP_TIMEOUT_SECONDS=10

# --- Behavior ---
DEDUP_TTL_MINUTES=360
RATE_LIMIT_PER_MINUTE=20

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN_REGEX=

# --- Logging ---
LOG_LEVEL=INFO
