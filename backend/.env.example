# Copy to .env for local development. .env is git-ignored.

ENV=local

# --- AWS / storage ---
AWS_REGION=ap-south-1
S3_BUCKET=your-dev-bucket-name
S3_PREFIX=weather-data/
# Local AWS credentials come from the standard AWS chain (aws configure / SSO / env).
# Do NOT put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in this file if you can avoid it.

# --- Open-Meteo ---
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
HTTP_TIMEOUT_SECONDS=10

# --- Behavior ---
DEDUP_TTL_MINUTES=360
RATE_LIMIT_PER_MINUTE=20

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN_REGEX=

# --- Logging ---
LOG_LEVEL=INFO
