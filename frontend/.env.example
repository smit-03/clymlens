# Copy to .env.local for local development.
# Base URL of the ClymLens backend (no trailing slash).
# If this is unset, the app falls back to this same value locally — but a
# deployed build (Vercel/Netlify/etc.) MUST set it explicitly as a platform
# environment variable and be rebuilt, or API calls will fail.
VITE_API_BASE_URL=http://localhost:8000
